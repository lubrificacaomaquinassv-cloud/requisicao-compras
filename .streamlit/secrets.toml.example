# Copie para secrets.toml (local) ou cole no Streamlit Cloud → Settings → Secrets
# Supabase: Project Settings → Database → Connection string (URI, modo Direct)

[connections.supabase]
dialect = "postgresql"
host = "aws-1-sa-east-1.pooler.supabase.com"
database = "postgres"
username = "postgres.SEU_PROJECT_REF"
password = "SUA_SENHA_DO_BANCO"
port = 6543

[connections.supabase.create_engine_kwargs]
connect_args = { sslmode = "require" }
